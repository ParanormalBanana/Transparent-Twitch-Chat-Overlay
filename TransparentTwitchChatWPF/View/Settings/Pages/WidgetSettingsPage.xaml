<UserControl x:Class="TransparentTwitchChatWPF.View.Settings.WidgetSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TransparentTwitchChatWPF.View.Settings"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Name="widgetGrid" Visibility="Visible" Margin="5,5,0,0" Grid.Row="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="20,12,20,0" FontWeight="Bold" Text="Default widgets" />
            <TextBlock
                Margin="20,4,20,0"
                FontStyle="Italic"
                TextWrapping="Wrap"
                Text="Stream Preview and Quick Actions use the Twitch account from Connections, so each widget does not ask you to log in." />
            <StackPanel Orientation="Horizontal" Margin="20,8,20,0">
                <ComboBox Name="DefaultWidgetCombo" Width="220" Height="28" />
                <Button
                    Content="Add"
                    Width="80"
                    Height="28"
                    Margin="8,0,0,0"
                    Click="AddDefaultWidget_Click" />
            </StackPanel>

            <TextBlock Margin="20,18,20,0" FontWeight="Bold" Text="Created widgets" />
            <TextBlock
                Name="NoWidgetsText"
                Margin="20,6,20,0"
                FontStyle="Italic"
                Text="No widgets yet." />
            <StackPanel Name="CreatedWidgetsPanel" Margin="20,4,20,0" />

            <Button
                Name="NewWidgetButton"
                Content="Create custom widget"
                Height="32"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Margin="20,18,0,0"
                VerticalAlignment="Top"
                Width="180"
                Click="NewWidgetButton_Click" />
            <TextBlock
                Margin="20,10,20,0"
                TextWrapping="Wrap"
                Text="For other widget URLs, see the wiki:" />
            <Label Margin="15,0,0,12">
                <Hyperlink NavigateUri = "https://github.com/baffler/Transparent-Twitch-Chat-Overlay/wiki"
                       Hyperlink.RequestNavigate = "Hyperlink_RequestNavigate" >
                    <TextBlock Text="https://github.com/baffler/Transparent-Twitch-Chat-Overlay/wiki" />
                </Hyperlink>
            </Label>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
