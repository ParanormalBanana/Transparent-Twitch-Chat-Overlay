<UserControl x:Class="TransparentTwitchChatWPF.View.Settings.BackupSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="Export" FontWeight="Bold" />
        <Button Content="Export settings" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Export_Click" />

        <TextBlock Text="Import" FontWeight="Bold" Margin="0,24,0,0" />
        <Button Content="Import settings" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Import_Click" />
    </StackPanel>
</UserControl>
